{
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "useTabs": false,
    "vueIndentScriptAndStyle": true,
    "endOfLine": "auto",
    "printWidth": 120,
    "arrowParens": "always",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "htmlWhitespaceSensitivity": "ignore",
    "singleAttributePerLine": true
}